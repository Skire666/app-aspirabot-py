{
  "path": "./__src__/",
  "rules": {
    "EPI101": {
      "enabled": true,
      "threshold_lines": 26
    },
    "EPI201": {
      "enabled": true,
      "max_score": 100,
      "min_complexity": 5,
      "min_lines": 12
    },
    "EPI301": {
      "enabled": true
    },
    "EPI302": {
      "enabled": true
    }
  },
  "exclude_dirs": [
    "__pycache__",
    ".venv",
    ".git",
    "node_modules",
    "tests"
  ],
  "output_format": "text"
}
